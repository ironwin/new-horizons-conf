let config = {
	address: "localhost",	// Address to listen on, can be:
							// - "localhost", "127.0.0.1", "::1" to listen on loopback interface
							// - another specific IPv4/6 to listen on a specific interface
							// - "0.0.0.0", "::" to listen on any interface
							// Default, when address config is left out or empty, is "localhost"
	port: 8080,
	basePath: "/",			// The URL path where MagicMirror² is hosted. If you are using a Reverse proxy
					  		// you must set the sub path here. basePath must end with a /
	ipWhitelist: ["127.0.0.1", "::ffff:127.0.0.1", "::1"],	// Set [] to allow all IP addresses

	useHttps: false, 		// Support HTTPS or not, default "false" will use HTTP
	httpsPrivateKey: "", 	// HTTPS private key path, only require when useHttps is true
	httpsCertificate: "", 	// HTTPS Certificate path, only require when useHttps is true

	language: "en",
	locale: "en-US",
	logLevel: ["DEBUG", "INFO", "LOG", "WARN", "ERROR"], // Add "DEBUG" for even more logging
	timeFormat: 24,
	units: "metric",

	modules: [
        {
            module: "MMM-MySlideshow",
            position: "fullscreen_below",
            config: {
                imagePaths:['/media/pi/SSD-256-USB/PHOTOS/@IMG_DIR@'], // 사진 폴더 경로
                slideshowSpeed: 10000,             // 슬라이드 시간 (ms)

                // 1. 세로 사진 잘림 방지 (얼굴 확대 방지)
                autoFitPortrait: true,             // 세로 사진 자동 감지
                backgroundSizePortrait: "contain", // 세로 사진 전체 표시 (좌우 여백 유지)
                blurredBackgroundForPortrait: false, // (선택) 여백에 블러 배경 채우기: true/false

                // 2. 사진 정보 및 위치 표시 설정
                showImageInfo: true,               // 정보 패널 활성화
                imageInfo: "date, location",       // 표시할 항목: "name, date, location, imagecount" 중 선택
                imageInfoLocation: "topLeft",  // 위치: bottomRight, bottomLeft, topRight, topLeft
                dateTimeFormat: "YYYY년 M월 D일 HH:mm", // 날짜 표시 형식 (또는 "YYYY.MM.DD HH:mm")
                locationLanguage: "ko",            // 지명 표시 언어 ("ko", "en" 등)

                // 3. 세로 사진 왼쪽 여백 지도 표시 설정
                showPortraitMap: true,             // 세로 사진일 때 왼쪽 여백에 지도 표시
                portraitMapPosition: "leftCenter", // 지도 위치: "leftCenter", "leftTop", "leftBottom"
                portraitMapTileTheme: "dark",      // 지도 테마: "dark" (매직미러용 다크 테마), "voyager", "osm"
                portraitMapApiKey: "cb1_2sbq_1_5ce7e2903fefa17bc3ed219d", // CartoDB API Key
                portraitMapZoom: 6,                // 기본 지도 줌 (6: 국가 전체 뷰)
                portraitMapFitCountry: true,       // 해당 국가 전체 영역 자동 맞춤 (기본값: true)
                portraitMapHighlightCountry: true, // 사진 촬영 국가 영역 하이라이트 강조 (기본값: true)
                portraitMapHighlightColor: "#00d2d3", // 하이라이트 색상 (청록/네온)

                // 4. 기타 슬라이드쇼 옵션
                randomizeImageOrder: true,
                transitionImages: true
            }
        },
        {
                module: "clock",
                position: "top_center", // This can be any of the regions.
                config: {
                        timeFormat: 24,
                        timezone:  "Asia/Seoul",
                        displaySeconds: false,
                        clockBold: true,
                        showSunTimes: true,
                        lat: 37.532600,
                        lon: 127.024612,
                     // The config property is optional.
                     // See 'Configuration options' for more information.
                },
         },

	]
};

/*************** DO NOT EDIT THE LINE BELOW ***************/
if (typeof module !== "undefined") {module.exports = config;}
